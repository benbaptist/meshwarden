# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION

DATABASE_URL=sqlite:////data/meshwarden.db

# Optional: comma-separated CORS origin allowlist for Socket.IO.
# Leave unset for the default same-origin policy, which works for any
# host/port you serve the dashboard on (localhost, LAN IP, reverse proxy).
# ALLOWED_ORIGINS=

FLASK_ENV=production

# Port Flask binds to inside the container
PORT=5000
# Port exposed on the host machine
HOST_PORT=5001
